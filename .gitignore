# ============================================================
# .gitignore — Swine Health Monitor
# ============================================================

# --- Datasets (too large for git; download separately) ---
datasets/
data/train/
data/valid/
data/test/
data/*.txt

# --- Trained Models (large binary files) ---
*.pt
*.onnx
*.engine
models/
runs/

# --- Database (runtime data) ---
data/*.db
*.db
*.sqlite
*.sqlite3

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/

# --- Virtual Environments ---
venv/
.venv/
env/
ENV/

# --- IDE & Editor ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb

# --- Logs ---
*.log
logs/

# --- Config secrets (never commit credentials) ---
config/secrets.yaml
.env
.env.*

# --- Temporary files ---
tmp/
temp/
*.tmp
